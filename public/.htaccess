# Les Dames du Parc — Contrôle des billets : configuration Apache du dossier public (racine du site).
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS obligatoire (tient compte d'un mandataire qui termine le TLS et transmet X-Forwarded-Proto).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # Fichiers cachés (.git, .env…) : interdits.
  RewriteRule (^|/)\. - [F,L]
</IfModule>

<IfModule mod_headers.c>
  # Les pages et l'API PHP envoient leurs propres en-têtes de sécurité (src/Http.php) ; ceux-ci couvrent les fichiers statiques.
  <FilesMatch "\.(css|js|webp|png|svg|webmanifest|txt)$">
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer"
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always unset X-Powered-By
</IfModule>

# Aucun fichier de sauvegarde, de configuration ou de journal servi par erreur.
<FilesMatch "\.(bak|old|orig|sql|log|ini|sh|md|dist|example|lock)$|~$">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_flag expose_php Off
  php_value upload_max_filesize 6M
  php_value post_max_size 8M
</IfModule>
